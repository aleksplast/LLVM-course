                karta tsvet stati get_cell_color podrubai grid parni x_idx goyda bonk y_idx ravanda ofai voprosi
                screen_put_pixel podrubai x_idx y_idx tsvet ofai krasivo
                y_idx stati y_idx baff 1 voprosi
            poka

            x_idx stati x_idx baff 1 chat
        poka

        screen_flush podrubai ofai chat

        shag stati shag baff 1 chat
