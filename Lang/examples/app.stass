                karta cell stati grid parni x_idx goyda bonk y_idx ravanda krasivo
                karta alive_num stati 0 voprosi

                vysadka sosedi parni 8 goyda bonk 2 ravanda voprosi
                sosedi parni 0 goyda bonk 0 ravanda stati x_idx damag 1 krasivo
                sosedi parni 0 goyda bonk 1 ravanda stati y_idx damag 1 krasivo
                sosedi parni 1 goyda bonk 0 ravanda stati x_idx damag 1 krasivo
                sosedi parni 1 goyda bonk 1 ravanda stati y_idx krasivo
                sosedi parni 2 goyda bonk 0 ravanda stati x_idx damag 1 krasivo
                sosedi parni 2 goyda bonk 1 ravanda stati y_idx baff 1 krasivo
                sosedi parni 3 goyda bonk 0 ravanda stati x_idx krasivo
                sosedi parni 3 goyda bonk 1 ravanda stati y_idx damag 1 krasivo
                sosedi parni 4 goyda bonk 1 ravanda stati x_idx krasivo
                sosedi parni 4 goyda bonk 0 ravanda stati y_idx baff 1 krasivo
                sosedi parni 5 goyda bonk 0 ravanda stati x_idx baff 1 krasivo
                sosedi parni 5 goyda bonk 1 ravanda stati y_idx damag 1 krasivo
                sosedi parni 6 goyda bonk 0 ravanda stati x_idx baff 1 krasivo
                sosedi parni 6 goyda bonk 1 ravanda stati y_idx krasivo
                sosedi parni 7 goyda bonk 0 ravanda stati x_idx baff 1 krasivo
                sosedi parni 7 goyda bonk 1 ravanda stati y_idx baff 1 krasivo

                karta sosed_idx stati 0 voprosi
                regat podrubai sosed_idx top4 8 ofai
                zdarova
                    karta sosed_x stati sosedi parni sosed_idx goyda bonk 0 ravanda chat
                    karta sosed_y stati sosedi parni sosed_idx goyda bonk 1 ravanda krasivo

                    vin podrubai sosed_x top5 0 ofai
                    zdarova
                        vin podrubai sosed_x top4 1000 ofai
                        zdarova
                            vin podrubai sosed_y top5 0 ofai
                            zdarova
                                vin podrubai sosed_y top4 900 ofai
                                zdarova
                                    karta sosed_cell stati grid parni sosed_x goyda bonk sosed_y ravanda krasivo
                                    vin podrubai sosed_cell top6 0 ofai
                                    zdarova
                                        alive_num stati alive_num baff 1 chat
                                    poka
                                poka
                            poka
                        poka
                    poka

                    sosed_idx stati sosed_idx baff 1 krasivo
                poka

                vin podrubai cell top6 0 ofai
                zdarova
                    vin podrubai alive_num top4 2 ofai
                    zdarova
                        new_grid parni x_idx goyda bonk y_idx ravanda stati 0 voprosi
                    poka
                    vinluz podrubai alive_num top1 3 ofai
                    zdarova
                        new_grid parni x_idx goyda bonk y_idx ravanda stati cell baff 1 voprosi
                    poka
                    vinluz podrubai alive_num top1 2 ofai
                    zdarova
                        new_grid parni x_idx goyda bonk y_idx ravanda stati cell baff 1 voprosi
                    poka
